APP_NAME="E-Ticaret"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Istanbul

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file

# Argon2id parametreleri (config/hashing.php)
HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=eticaret
DB_USERNAME=eticaret
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=prefer

# Oturum: canlıda SESSION_SECURE_COOKIE=true ve SESSION_ENCRYPT=true olmalı
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Geliştirmede Mailpit (http://localhost:8025)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="destek@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Sosyal giriş (Faz 4) — admin panelinden de yönetilebilecek
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Admin paneli yolu (tahmin edilmesi zor bir değer seçin)
ADMIN_PATH=yonetim

VITE_APP_NAME="${APP_NAME}"
